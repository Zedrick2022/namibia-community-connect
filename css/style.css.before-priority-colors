/* =========================================
   NAMIBIA COMMUNITY CONNECT
   Main Stylesheet
   ========================================= */

/* ---------- Base ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background: #f7f9fc;
    color: #172033;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1120px, 92%);
    margin: 0 auto;
}

/* ---------- Navigation ---------- */

header {
    background: #ffffff;
    border-bottom: 1px solid #e5e9f0;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    width: min(1120px, 92%);
    margin: 0 auto;
    min-height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
}

.logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: #123c69;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

.nav-links a {
    font-size: 0.95rem;
    font-weight: 600;
    color: #536174;
    transition: 0.2s ease;
}

.nav-links a:hover {
    color: #123c69;
}

/* ---------- Hero ---------- */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;

    background:
        radial-gradient(
            circle at 85% 20%,
            rgba(18, 60, 105, 0.12),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #eef5fb,
            #ffffff
        );
}

.hero-content {
    width: min(1120px, 92%);
    margin: 0 auto;
    padding: 90px 0;
}

.eyebrow {
    margin-bottom: 15px;

    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;

    color: #d46a1f;
}

.hero h1 {
    max-width: 760px;

    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.05;

    letter-spacing: -0.04em;

    margin-bottom: 25px;
}

.hero-text {
    max-width: 650px;

    font-size: 1.15rem;
    color: #59677a;

    margin-bottom: 35px;
}

/* ---------- Buttons ---------- */

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 52px;
    padding: 0 25px;

    border-radius: 10px;

    font-weight: 700;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button.primary {
    background: #123c69;
    color: #ffffff;

    box-shadow:
        0 10px 25px rgba(18, 60, 105, 0.2);
}

.button.primary:hover {
    background: #0c2e52;
}

.button.secondary {
    background: #ffffff;
    color: #123c69;

    border: 1px solid #d9e1eb;
}

.button.secondary:hover {
    box-shadow:
        0 8px 20px rgba(20, 35, 55, 0.08);
}

/* ---------- Sections ---------- */

.problem,
.how-it-works {
    width: min(1120px, 92%);
    margin: 0 auto;

    padding: 100px 0;
}

.section-heading {
    max-width: 700px;
    margin-bottom: 45px;
}

.section-heading h2 {
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.1;

    margin-bottom: 20px;

    letter-spacing: -0.03em;
}

.section-heading > p:last-child {
    color: #687589;
    font-size: 1.05rem;
}

/* ---------- Feature Cards ---------- */

.feature-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 22px;
}

.feature-card {
    background: #ffffff;

    border: 1px solid #e5e9f0;
    border-radius: 16px;

    padding: 30px;

    box-shadow:
        0 10px 35px rgba(23, 32, 51, 0.05);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.feature-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 18px 45px rgba(23, 32, 51, 0.09);
}

.icon {
    width: 50px;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 20px;

    border-radius: 12px;

    background: #eef5fb;

    font-size: 1.5rem;
}

.feature-card h3 {
    margin-bottom: 10px;

    font-size: 1.25rem;
}

.feature-card p {
    color: #687589;
}

/* ---------- How It Works ---------- */

.how-it-works {
    padding-top: 20px;
}

.steps {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 22px;
}

.step {
    padding: 30px;

    background: #172033;
    color: #ffffff;

    border-radius: 16px;
}

.step span {
    display: block;

    margin-bottom: 15px;

    font-size: 0.8rem;
    font-weight: 800;

    letter-spacing: 0.12em;

    color: #f09a58;
}

.step h3 {
    margin-bottom: 10px;

    font-size: 1.4rem;
}

.step p {
    color: #c5ceda;
}

/* ---------- Footer ---------- */

footer {
    padding: 35px 5%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    background: #111827;
    color: #aeb8c7;

    font-size: 0.9rem;
}

/* ---------- Responsive ---------- */

@media (max-width: 800px) {

    nav {
        padding: 15px 0;

        flex-direction: column;
        align-items: flex-start;
    }

    .nav-links {
        width: 100%;

        overflow-x: auto;

        padding-bottom: 5px;
    }

    .hero {
        min-height: auto;
    }

    .hero-content {
        padding: 75px 0;
    }

    .feature-grid,
    .steps {
        grid-template-columns: 1fr;
    }

    footer {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 500px) {

    .hero h1 {
        font-size: 2.6rem;
    }

    .hero-text {
        font-size: 1rem;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .button {
        width: 100%;
    }

    .problem,
    .how-it-works {
        padding: 70px 0;
    }
}
/* ---------- Report Page ---------- */

.report-page {
    width: min(760px, 92%);
    margin: 0 auto;
    padding: 80px 0 100px;
}

.report-page h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.1;
    margin-bottom: 20px;
}

#issueForm {
    background: #ffffff;

    padding: 35px;

    border: 1px solid #e5e9f0;
    border-radius: 18px;

    box-shadow:
        0 15px 40px rgba(23, 32, 51, 0.06);
}

.form-group {
    margin-bottom: 25px;
}

.form-group label {
    display: block;

    margin-bottom: 8px;

    font-weight: 700;
}

.form-group label span {
    font-weight: 400;
    color: #7b8798;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    padding: 14px 16px;

    border: 1px solid #d8dee8;
    border-radius: 9px;

    background: #ffffff;

    color: #172033;

    font: inherit;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #123c69;

    box-shadow:
        0 0 0 3px rgba(18, 60, 105, 0.1);
}

.form-group textarea {
    resize: vertical;
}

.form-group input[type="file"] {
    padding: 11px;
}

#issueForm .button {
    border: none;
    cursor: pointer;
}

@media (max-width: 600px) {

    #issueForm {
        padding: 25px 20px;
    }

    .report-page {
        padding-top: 60px;
    }
}
/* ---------- Issues Dashboard ---------- */

.issues-page {
    width: min(1120px, 92%);
    margin: 0 auto;
    padding: 80px 0 100px;
}

.issues-page h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.1;
    margin-bottom: 20px;
}

.issue-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 35px;
}

.issue-controls select {
    min-width: 200px;

    padding: 13px 15px;

    border: 1px solid #d8dee8;
    border-radius: 9px;

    background: #ffffff;

    color: #172033;

    font: inherit;
}

.issues-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 22px;
}

.issue-card {
    background: #ffffff;

    padding: 28px;

    border: 1px solid #e5e9f0;
    border-radius: 16px;

    box-shadow:
        0 10px 35px rgba(23, 32, 51, 0.05);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.issue-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 16px 40px rgba(23, 32, 51, 0.09);
}

.issue-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 20px;
}

.issue-category {
    font-size: 0.78rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.06em;

    color: #d46a1f;
}

.issue-status {
    padding: 6px 10px;

    border-radius: 20px;

    background: #eef5fb;

    color: #123c69;

    font-size: 0.78rem;
    font-weight: 700;
}

.issue-card h3 {
    margin-bottom: 10px;

    font-size: 1.35rem;
}

.issue-card p {
    color: #687589;

    margin-bottom: 25px;
}

.issue-card-bottom {
    display: flex;
    justify-content: space-between;

    gap: 15px;

    padding-top: 18px;

    border-top: 1px solid #edf0f4;

    font-size: 0.85rem;

    color: #7b8798;
}

.issue-card-bottom strong {
    color: #123c69;
}

.empty-state {
    display: none;

    text-align: center;

    padding: 70px 20px;

    background: #ffffff;

    border: 1px dashed #ccd4df;
    border-radius: 16px;
}

.empty-state h2 {
    margin-bottom: 10px;
}

.empty-state p {
    color: #687589;

    margin-bottom: 25px;
}

@media (max-width: 700px) {

    .issues-grid {
        grid-template-columns: 1fr;
    }

    .issue-controls {
        flex-direction: column;
    }

    .issue-controls select {
        width: 100%;
    }

    .issue-card-top,
    .issue-card-bottom {
        align-items: flex-start;
    }
}
/* ---------- Issue Details ---------- */

.issue-details-page {
    width: min(900px, 92%);
    margin: 0 auto;

    padding: 70px 0 100px;
}

.back-link {
    display: inline-block;

    margin-bottom: 25px;

    color: #123c69;

    font-weight: 700;
}

.issue-details-card {
    background: #ffffff;

    padding: 40px;

    border: 1px solid #e5e9f0;
    border-radius: 18px;

    box-shadow:
        0 15px 45px rgba(23, 32, 51, 0.07);
}

.details-header {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    gap: 25px;

    padding-bottom: 30px;

    border-bottom: 1px solid #edf0f4;
}

.details-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);

    line-height: 1.1;

    margin-bottom: 8px;
}

.issue-id {
    color: #7b8798;

    font-size: 0.9rem;

    font-weight: 700;
}

.issue-status.large {
    padding: 9px 15px;

    white-space: nowrap;
}

.details-section {
    padding: 30px 0;

    border-bottom: 1px solid #edf0f4;
}

.details-section:last-child {
    border-bottom: none;
}

.details-section h2 {
    margin-bottom: 12px;

    font-size: 1.2rem;
}

.details-section p {
    color: #687589;

    font-size: 1.05rem;
}

.details-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 20px;
}

.details-grid > div {
    padding: 20px;

    background: #f7f9fc;

    border-radius: 10px;
}

.detail-label {
    display: block;

    margin-bottom: 5px;

    color: #7b8798;

    font-size: 0.8rem;

    text-transform: uppercase;

    letter-spacing: 0.06em;
}

.details-grid strong {
    color: #172033;
}

.status-timeline {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 8px;

    margin-top: 30px;
}

.timeline-step {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 8px;

    text-align: center;

    color: #8a96a6;
}

.timeline-step span {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #edf0f4;

    font-weight: 800;
}

.timeline-step.active {
    color: #123c69;
}

.timeline-step.active span {
    background: #123c69;

    color: #ffffff;
}

.timeline-line {
    height: 2px;

    flex: 1;

    background: #e1e6ed;
}

@media (max-width: 700px) {

    .issue-details-card {
        padding: 25px 20px;
    }

    .details-header {
        flex-direction: column;
    }

    .details-grid {
        grid-template-columns: 1fr;
    }

    .status-timeline {
        align-items: stretch;

        flex-direction: column;
    }

    .timeline-step {
        flex-direction: row;

        text-align: left;
    }

    .timeline-line {
        width: 2px;

        height: 20px;

        flex: none;

        margin-left: 19px;
    }
}
/* ---------- Status Controls ---------- */

.status-help {
    margin-bottom: 20px;
}

.status-controls {
    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 20px;
}

.status-controls select {
    min-width: 220px;

    padding: 13px 15px;

    border: 1px solid #d8dee8;

    border-radius: 9px;

    background: #ffffff;

    color: #172033;

    font: inherit;
}

.status-controls .button {
    border: none;

    cursor: pointer;
}
/* ---------- Issue Photo ---------- */

.issue-photo {
    display: block;
    width: 100%;
    max-width: 700px;
    max-height: 500px;
    object-fit: cover;
    border-radius: 12px;
    margin-top: 15px;
    border: 1px solid #d8dee8;
}
/* ---------- Dashboard Statistics ---------- */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 30px 0;
}

.stat-card {
    background: #ffffff;
    border: 1px solid #e1e6ee;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(18, 60, 105, 0.06);
}

.stat-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #667085;
    margin-bottom: 10px;
}

.stat-card strong {
    display: block;
    font-size: 34px;
    line-height: 1;
    color: #123c69;
}
/* ---------- Photo Evidence Indicator ---------- */

.photo-indicator {
    display: inline-block;
    margin-top: 15px;
    padding: 7px 11px;
    background: #f3f7fb;
    color: #123c69;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
}
/* =================================
   STEP 17: ISSUE CARD IMPROVEMENTS
================================= */

.issue-card {
    background: #ffffff;
    border: 1px solid #e1e6ee;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(18, 60, 105, 0.06);
    transition: transform 0.2s ease,
                box-shadow 0.2s ease;
    cursor: pointer;
    overflow-wrap: anywhere;
}

.issue-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(18, 60, 105, 0.12);
}

.issue-card h3 {
    color: #123c69;
    font-size: 20px;
    line-height: 1.4;
    margin: 18px 0 10px;
}

.issue-card p {
    color: #475467;
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 20px;
}

.issue-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.issue-category,
.issue-status {
    display: inline-block;
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

.issue-category {
    background: #edf4fc;
    color: #123c69;
}

.issue-status {
    background: #fff3df;
    color: #8a4b08;
}

.issue-card-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    border-top: 1px solid #e1e6ee;
    padding-top: 18px;
    margin-top: 18px;
}

.issue-card-info > div {
    min-width: 0;
}

.issue-card-info .detail-label {
    display: block;
    margin-bottom: 6px;
}

.issue-card-info strong {
    display: block;
    color: #172033;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.view-details {
    color: #2563eb;
    font-size: 14px;
    font-weight: 700;
    margin-top: 22px;
}

.issue-card:hover .view-details {
    text-decoration: underline;
}

@media (max-width: 480px) {
    .issue-card {
        padding: 18px;
    }

    .issue-card-info {
        gap: 14px 10px;
    }

    .issue-card h3 {
        font-size: 18px;
    }
}
/* =====================================
   MOBILE DASHBOARD STATISTICS FIX
===================================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
}

.stat-card {
    min-width: 0;
    box-sizing: border-box;
    padding: 22px 16px;
}

.stat-label {
    display: block;
    font-size: 14px;
    line-height: 1.4;
    overflow-wrap: normal;
    word-break: normal;
}

.stat-card strong {
    font-size: 32px;
    line-height: 1.2;
}

/* Tablets and mobile phones */

@media (max-width: 768px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .stat-card {
        padding: 18px 14px;
        min-height: 105px;
    }

    .stat-label {
        font-size: 14px;
        line-height: 1.4;
    }

    .stat-card strong {
        font-size: 30px;
        margin-top: 10px;
    }
}

/* Very narrow phones */

@media (max-width: 380px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .stat-card {
        padding: 14px 12px;
        min-height: 95px;
    }

    .stat-label {
        font-size: 12px;
    }

    .stat-card strong {
        font-size: 26px;
    }
}

/* =====================================
   STEP 18B: MOBILE NAVIGATION
===================================== */

@media (max-width: 600px) {

    header {
        padding: 18px 20px;
    }

    .nav-container {
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
    }

    .logo {
        font-size: 21px;
        line-height: 1.35;
    }

    nav {
        width: 100%;
    }

    nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        padding: 0;
        margin: 0;
    }

    nav ul li {
        list-style: none;
    }

    nav ul li a {
        font-size: 14px;
    }

}

/* =========================================
   NAMIBIA COMMUNITY CONNECT
   PROFESSIONAL ISSUE CARD DESIGN
========================================= */

.issues-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
}

.issue-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    box-sizing: border-box;
    padding: 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 5px 18px rgba(18, 60, 105, 0.06);
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
}

.issue-card:hover {
    transform: translateY(-3px);
    border-color: #b7cce5;
    box-shadow: 0 12px 28px rgba(18, 60, 105, 0.12);
}

.issue-card:focus-within {
    outline: 2px solid #2563eb;
    outline-offset: 3px;
}

.issue-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 18px;
}

.issue-category,
.issue-status {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    box-sizing: border-box;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.issue-category {
    background: #edf4fc;
    color: #123c69;
}

.issue-status {
    background: #eef5fb;
    color: #123c69;
}

/* Status-specific colours */

.issue-status:has(+ .unused-status-marker) {
    background: #eef5fb;
}

.issue-card h3 {
    margin: 0 0 12px;
    color: #123c69;
    font-size: 20px;
    line-height: 1.4;
    overflow-wrap: anywhere;
}

.issue-card p {
    margin: 0 0 20px;
    color: #526174;
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.issue-card-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 14px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid #e8edf3;
}

.issue-card-info > div {
    min-width: 0;
}

.issue-card-info .detail-label {
    display: block;
    margin-bottom: 6px;
    color: #778397;
    font-size: 11px;
    line-height: 1.4;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.045em;
}

.issue-card-info strong {
    display: block;
    color: #25364a;
    font-size: 13px;
    line-height: 1.55;
    overflow-wrap: anywhere;
    word-break: normal;
}

.photo-indicator {
    margin-top: 16px;
    padding: 10px 12px;
    border: 1px solid #d9e8f7;
    border-radius: 9px;
    background: #f3f8fd;
    color: #245783;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
}

.view-details {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #edf0f4;
    color: #2563eb;
    font-size: 14px;
    font-weight: 700;
}

.issue-card:hover .view-details {
    text-decoration: underline;
}

@media (max-width: 700px) {
    .issues-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
    }

    .issue-card {
        padding: 20px;
        border-radius: 15px;
    }

    .issue-card h3 {
        font-size: 19px;
    }
}

@media (max-width: 360px) {
    .issue-card {
        padding: 16px;
    }

    .issue-card-info {
        gap: 14px 10px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .issue-card {
        transition: none;
    }

    .issue-card:hover {
        transform: none;
    }
}

